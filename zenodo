ction(X, y, method, title):\n    plt.figure(figsize=(10, 8))\n    for label in np.unique(y):\n        indices = np.where(y == label)\n        plt.scatter(X[indices, 0], X[indices, 1], label=f\"Label {label}\", alpha=0.6)\n    plt.title(title)\n    plt.legend()\n    plt.show()\n\n# Merge embeddings for paired analysis\ndef get_embeddings(row):\n    return phenotype_embeddings.loc[row['Phenotype']].values, gene_embeddings.loc[row['Gene']].values\n\nsampled_data['Phenotype_Embedding'], sampled_data['Gene_Embedding'] = zip(*sampled_data.apply(get_embeddings, axis=1))\n\n# PCA Reduction\nphenotype_vectors = np.array(list(sampled_data['Phenotype_Embedding']))\ngene_vectors = np.array(list(sampled_data['Gene_Embedding']))\n\npca = PCA(n_components=2)\nphenotype_pca = pca.fit_transform(phenotype_vectors)\ngene_pca = pca.fit_transform(gene_vectors)\nplot_dim_reduction(phenotype_pca, sampled_data['Causal'], 'PCA', 'Phenotype Embeddings with PCA')\n\n# t-SNE\ntsne = TSNE(n_components=2, random_state=hash_seed)\nphenotype_tsne = tsne.fit_transform(phenotype_vectors)\nplot_dim_reduction(phenotype_tsne, sampled_data['Causal'], 't-SNE', 'Phenotype Embeddings with t-SNE')\n\n# UMAP\numap_model = umap.UMAP(n_neighbors=15, random_state=hash_seed)\nphenotype_umap = umap_model.fit_transform(phenotype_vectors)\nplot_dim_reduction(phenotype_umap, sampled_data['Causal'], 'UMAP', 'Phenotype Embeddings with UMAP')\n\n# Step 4: Vector Similarity Analysis\ndef calculate_similarity(row):\n    cosine_sim = 1 - cosine(row['Phenotype_Embedding'], row['Gene_Embedding'])\n    euclidean_dist = euclidean(row['Phenotype_Embedding'], row['Gene_Embedding'])\n    return pd.Series([cosine_sim, euclidean_dist])\n\nsampled_data[['Cosine_Similarity', 'Euclidean_Distance']] = sampled_data.apply(calculate_similarity, axis=1)\n\n# Analyze similarity metrics\nplt.figure(figsize=(10, 6))\nplt.hist(sampled_data['Cosine_Similarity'][sampled_data['Causal'] == 1], alpha=0.7, label='Causal', bins=30)\nplt.hist(sampled